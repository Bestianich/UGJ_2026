@startuml 

class PlaneConsole <<(M , lightblue)>>
{
    +Action<ButtonOperation>: OnRegisterNewOperation
    +Action<int, int, int>: OnExecuteOperation

    -int: _maxAltitude
    -int: _goalAltitude
    -int: _currentAltitude
    -int: _secondOperator
    -ButtonOperation: _selectedOperation
    
    +void: RegisterNewOperation(ButtonOperation)
    +void: ExecuteOperation()
        
    -void: Sum()
    -void: Substract()
    -void: Multiply()
    -void: Divide()
    -void: Random()
    -void: Swap()
    -void: Shuffle()
    -void: RemoveSX()
    -void: RemoveDX()
    
} 

class PlaneConsoleUIHandler <<(M , lightblue)>>
{
    -PlaneConsole: _planeConsole
    -TextMeshPro: _goalAltitudeText
    -TextMeshPro: _currentAltitudeText
    -TextMeshPro: _secondOperatorText
    -ButtonOperation: _selectedOperation
    
    +void: UpdateSelectedOperation(ButtonOperation)
    +void: UpdateUI(int , int , int)
     
}

class ButtonOperation
{
    +Operation: Operation
    +GameObject: OperationVFX
}

enum Operation
{
    +SUM
    +SUBSTRACT
    +MULTIPLY
    +DIVISION
    +RANDOM
    +SWAP
    +SHUFFLE
    +REMOVESX
    +REMOVEDX
}

class Button <<(M , lightblue)>>
{
    +UnityEvent<ButtonOperation>: OnClickEvent
    -ButtonOperation: _buttonOperation
    +void: OnClick()
}

PlaneConsole -* ButtonOperation
PlaneConsoleUIHandler -* PlaneConsole
PlaneConsole <--  Button
Button -* ButtonOperation
ButtonOperation -* Operation
@enduml